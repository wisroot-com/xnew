{
  "name": "@mulsense/xnew",
  "description": "JavaScript / TypeScript library for component-oriented programming.",
  "keywords": [
    "Component-Oriented Programming"
  ],
  "version": "0.9.3",
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "module": "dist/xnew.mjs",
  "types": "dist/xnew.d.ts",
  "exports": {
    ".": {
      "types": "./dist/xnew.d.ts",
      "import": "./dist/xnew.mjs"
    },
    "./addons/xmatter": {
      "types": "./dist/addons/xmatter.d.ts",
      "import": "./dist/addons/xmatter.mjs"
    },
    "./addons/xpixi": {
      "types": "./dist/addons/xpixi.d.ts",
      "import": "./dist/addons/xpixi.mjs"
    },
    "./addons/xrapier2d": {
      "types": "./dist/addons/xrapier2d.d.ts",
      "import": "./dist/addons/xrapier2d.mjs"
    },
    "./addons/xrapier3d": {
      "types": "./dist/addons/xrapier3d.d.ts",
      "import": "./dist/addons/xrapier3d.mjs"
    },
    "./addons/xthree": {
      "types": "./dist/addons/xthree.d.ts",
      "import": "./dist/addons/xthree.mjs"
    },
    "./addons/xreact": {
      "types": "./dist/addons/xreact.d.ts",
      "import": "./dist/addons/xreact.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulsense/xnew.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mulsense/xnew/issues"
  },
  "homepage": "https://github.com/mulsense/xnew#readme",
  "scripts": {
    "test": "jest",
    "types:check": "tsc --noEmit -p tsconfig.json",
    "build": "npx rollup --config rollup.config.js --bundleConfigAsCjs",
    "dev": "npx rollup --config rollup.config.js --watch --bundleConfigAsCjs"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0",
    "three": ">=0.176.0",
    "matter-js": "^0.20.0",
    "@dimforge/rapier2d-compat": "^0.19.0",
    "@dimforge/rapier3d-compat": "^0.19.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": { "optional": true },
    "three": { "optional": true },
    "matter-js": { "optional": true },
    "@dimforge/rapier2d-compat": { "optional": true },
    "@dimforge/rapier3d-compat": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@mulsense/xnew": "^0.3.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.15.17",
    "@types/react": "^19.0.0",
    "@types/three": "^0.176.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.9.2",
    "react": "^19.0.0",
    "rollup": "^3.3.0",
    "rollup-plugin-dts": "^6.2.1",
    "three": "^0.176.0",
    "ts-jest": "^29.3.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
